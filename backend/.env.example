PORT=5000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/skillsync?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Blockchain RPC and Private Key
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key
BLOCKCHAIN_PRIVATE_KEY=your_blockchain_private_key_hex
ADMIN_PRIVATE_KEY=your_admin_private_key_hex

# Smart Contract Addresses
APPLICANT_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
ORGANISATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
REQUEST_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
EMPLOYMENT_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
CERTIFICATE_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Email Service (Nodemailer)
# EMAIL_PASS MUST be a 16-character Google App Password (not your personal account password).
# How to generate: Google Account -> Security -> 2-Step Verification -> App passwords.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# GitHub OAuth Application (https://github.com/settings/developers)
# Authorization callback URL must be: http://localhost:5000/api/student/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/student/github/callback
